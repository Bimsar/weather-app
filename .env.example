# Copy this file to ".env" and fill in your own values.
# ".env" is listed in .gitignore, so your real secrets are never committed.

# Used by Flask to sign the session cookie (recent searches, °C/°F choice).
# Generate a strong one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to 1 locally for auto-reload and helpful error pages. NEVER 1 in production.
FLASK_DEBUG=1
